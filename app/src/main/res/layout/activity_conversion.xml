<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degradado"
    android:fillViewport="true"
    tools:context=".ConversionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✿ Conversor ✿"
            android:textColor="#C2185B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#7B5E7B"
            android:textSize="15sp" />

        <!-- Tarjeta con el formulario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeColor="#F8BBD0"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡ Valor que quieres convertir"
                    android:textColor="#7B5E7B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etValor"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_campo"
                    android:hint="Por ejemplo, 5"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="#7B3F61"
                    android:textColorHint="#C9A9BE"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="✧ De"
                    android:textColor="#7B5E7B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spOrigen"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_spinner"
                    android:contentDescription="Unidad de origen"
                    android:paddingStart="10dp"
                    android:popupBackground="#FFF8FB" />

                <!-- Botón para intercambiar las unidades -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIntercambiar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="⇅ Intercambiar"
                    android:textColor="#9575CD"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✧ A"
                    android:textColor="#7B5E7B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spDestino"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_spinner"
                    android:contentDescription="Unidad de destino"
                    android:paddingStart="10dp"
                    android:popupBackground="#FFF8FB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConvertir"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="22dp"
                    android:text="Convertir ♡"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EC407A"
                    app:cornerRadius="29dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta del resultado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="★ Resultado"
            android:textColor="#7B5E7B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_resultado"
            android:gravity="center"
            android:minHeight="80dp"
            android:padding="16dp"
            android:text="Aquí aparecerá la conversión ✨"
            android:textColor="#5E35B1"
            android:textSize="19sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="← Elegir otra categoría"
            android:textColor="#C2185B"
            app:cornerRadius="26dp"
            app:strokeColor="#F48FB1"
            app:strokeWidth="2dp" />

        <ImageView
            android:id="@+id/ivMascota"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:contentDescription="Mascota del conversor"
            android:scaleType="fitCenter"
            android:src="@drawable/pngwing" />
    </LinearLayout>
</ScrollView>
